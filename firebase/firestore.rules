rules_version = '2';

// 겸사겸사 Firestore 보안 규칙
//
// 원칙 두 가지.
//  1. `users/{uid}` 아래는 **본인만** 읽고 쓴다. 포인트·쿠폰·지원 내역은 남이 볼 이유가 없다.
//  2. `requests`(공개 부탁글)는 누구나 읽지만, 쓰는 건 글쓴이 본인만이다.
//     로그인하지 않은 사람도 목록을 볼 수 있어야 앱 첫 화면이 비지 않는다.
//
// 콘솔 > Firestore Database > 규칙에 이 내용을 붙여넣고 '게시'를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── 내 자료 ────────────────────────────────────────────────────────
    // users/{uid}              프로필 (닉네임·지역·포인트·본인인증)
    //   bookmarks/{requestId}  관심 저장
    //   trades/{requestId}     지원·거래 단계
    //   offers/{requestId}     내가 보낸 가격 제안
    //   coupons/{couponId}     교환한 쿠폰
    //   ledger/{rewardKey}     포인트 적립 원장
    match /users/{uid} {
      allow read, write: if isMe(uid);

      match /{document=**} {
        allow read, write: if isMe(uid);
      }
    }

    // ── 공개 부탁글 ────────────────────────────────────────────────────
    match /requests/{requestId} {
      allow read: if true;

      // 남의 이름으로 글을 올릴 수 없다
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid;

      // 글쓴이만 수정·마감할 수 있고, 주인은 바뀌지 않는다
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
