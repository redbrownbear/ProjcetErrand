rules_version = '2';

// 겸사겸사 Firestore 보안 규칙 v2 — 설계: docs/1차_백엔드_설계.md (W2)
//
// 원칙
//  1. 상태를 바꾸는 쓰기(지원·수락·거래 단계·포인트)는 서버(Cloud Functions, Admin SDK)만 한다.
//     Admin SDK는 이 규칙을 거치지 않는다. 앱은 functions/src/errand/callables.ts 의 함수를 부른다.
//  2. 공개 정보와 거래 당사자 정보는 문서 단위로 나눈다.
//     requests/{id} 는 누구나 읽지만 정확한 위치·주소는 requests/{id}/private/detail 에만 둔다.
//  3. 앱이 쓸 수 있는 필드는 목록으로 정해 둔다(화이트리스트). 목록 밖 필드는 거부한다.
//
// 배포: firebase deploy --project dev --only firestore  (콘솔 붙여넣기 대신)
// 주의: 이 규칙은 앱의 W3 변경(함수 호출)과 함께 운영(prod)에 배포한다. 그 전의 앱은 지원·포인트 쓰기가 거부된다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 ──────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function incoming() { return request.resource.data; }
    function onlyKeys(allowed) { return incoming().keys().hasOnly(allowed); }
    function changedOnly(allowed) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(allowed);
    }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function money(v) { return v is int && v >= 0 && v <= 10000000; }
    function optStr(m, k, max) { return !(k in m) || m[k] == null || str(m[k], 0, max); }
    function optMoney(m, k) { return !(k in m) || m[k] == null || money(m[k]); }

    // ── 사용자 ────────────────────────────────────────────────────────────
    // 동선의 출발 · 도착: 사람이 고른 이름과 동네, 격자만(좌표 없음)
    function routePoint(p) {
      return p is map && p.keys().hasOnly(['label', 'area', 'cell6'])
          && str(p.label, 1, 40) && optStr(p, 'area', 30)
          && p.cell6 is string && p.cell6.matches('^[0-9b-hjkmnp-z]{6}$');
    }
    function routeValid(m) {
      return str(m.name, 1, 20)
          && routePoint(m.from) && routePoint(m.to)
          && m.days is list && m.days.size() >= 1 && m.days.size() <= 7
          && m.window is map && m.window.keys().hasOnly(['start', 'end'])
          && m.window.start is string && m.window.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && m.window.end is string && m.window.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && m.mode in ['walk', 'transit', 'car', 'bike']
          && m.radiusM is int && m.radiusM >= 100 && m.radiusM <= 8000
          && m.active is bool;
    }

    // 여행 · 출국 일정(A11). 날짜는 'YYYY-MM-DD' 문자열이라 글자 순서 = 날짜 순서
    function ymd(v) { return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function travelValid(m) {
      return m.cc is string && m.cc.matches('^[a-z]{2}$')
          && str(m.city, 0, 30)
          && ymd(m.depart) && ymd(m.back) && m.back >= m.depart
          && m.takeAsks is bool
          && optStr(m, 'note', 60);
    }
    function travelKeys() { return ['cc', 'city', 'depart', 'back', 'takeAsks', 'note', 'createdAt', 'updatedAt']; }

    // 서버만 쓰는 필드: 포인트 사본, 본인인증, 운영자 역할, 이용 정지, 집계
    function serverUserFields() { return ['points', 'verified', 'role', 'suspended', 'stats']; }

    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && !incoming().keys().hasAny(serverUserFields());
      allow update: if isMe(uid) && !incoming().diff(resource.data).affectedKeys().hasAny(serverUserFields());
      allow delete: if false; // 탈퇴는 서버 함수로(R02)

      match /fcmTokens/{token} { allow read, write: if isMe(uid); }
      match /bookmarks/{requestId} { allow read, write: if isMe(uid); }
      match /blocks/{targetUid} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && targetUid != uid;
      }
      // 알림은 서버가 만들고, 앱은 읽음 표시만 한다
      match /notifications/{id} {
        allow read: if isMe(uid);
        allow update: if isMe(uid) && changedOnly(['readAt']);
      }
      // 정기 동선(W6 · A02). 본인만. 정확한 좌표는 못 쓰고 격자(geohash 6자리)와 이름만.
      // 매칭용 격자(cells · overLimit · cellsAt)는 서버 트리거 onRouteWrite만 쓴다
      match /routes/{routeId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && routeValid(incoming())
          && onlyKeys(['name', 'from', 'to', 'days', 'window', 'mode', 'radiusM', 'active', 'createdAt', 'updatedAt']);
        allow update: if isMe(uid) && routeValid(incoming())
          && !incoming().diff(resource.data).affectedKeys().hasAny(['cells', 'overLimit', 'cellsAt', 'createdAt']);
      }

      // 여행 · 출국 일정(A11). 본인만. 해외 사다주기(B04)가 열리기 전까지는 모아 두기만 한다
      match /travels/{id} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && travelValid(incoming()) && onlyKeys(travelKeys());
        allow update: if isMe(uid) && travelValid(incoming()) && onlyKeys(travelKeys())
          && incoming().createdAt == resource.data.createdAt;
      }

      // 내 동선에 맞는 부탁(A13). 서버가 만들고, 본인은 읽고 지운다(관심 없음)
      match /matches/{requestId} { allow read, delete: if isMe(uid); }
      // 서버 전용 카운터(추천 푸시 하루 상한 등)
      match /meta/{id} { allow read: if isMe(uid); }

      // 동의 · 철회 기록(A21). 추가만 하고 고치거나 지우지 않는다. 시각은 서버 시각만 받는다
      match /consentLog/{id} {
        allow read: if isMe(uid);
        allow create: if isMe(uid)
          && onlyKeys(['key', 'on', 'v', 'at'])
          && incoming().key in ['terms', 'privacy', 'age14', 'location', 'marketing', 'night']
          && incoming().on is bool
          && str(incoming().v, 1, 20)
          && incoming().at == request.time;
      }
      // 포인트 원장: 서버만 쓴다(W8)
      match /pointLedger/{id} { allow read: if isMe(uid); }

      // 프로토타입 기록(앱이 직접 쓰던 것). 새 구조로 옮기지 않고 읽기만 남겼다가 정리한다(결정 4)
      match /trades/{id} { allow read: if isMe(uid); }
      match /offers/{id} { allow read: if isMe(uid); }
      match /coupons/{id} { allow read: if isMe(uid); }
      match /ledger/{id} { allow read: if isMe(uid); }
      match /payEntries/{id} { allow read: if isMe(uid); }
    }

    // 공지 · 업데이트(A33). 누구나 읽고, 올리기는 콘솔 · 스크립트(functions/scripts/post-notice.js)로만
    match /notices/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 공개 완료 기록(A23, LIVE 보드 티커). 서버가 거래 완료 때 동네 · 종류 · 시각만 쓴다
    match /activity/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 운영 설정(금지 품목 · 물건값 상한 등, A20). 앱은 읽기만, 고치는 건 콘솔 · 서버
    match /config/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 다른 사람이 볼 수 있는 프로필. 서버가 users 문서에서 골라 만든다
    match /publicProfiles/{uid} {
      allow read: if signedIn();
    }

    // ── 공개 부탁글 ───────────────────────────────────────────────────────
    // 정확한 위치(place·deliveryPlace·lat·lng)는 여기 두지 않는다 → private/detail
    function requestEditable() {
      return ['who', 'cat', 'title', 'desc', 'region', 'area', 'cell', 'country', 'cc', 'city',
              'mins', 'price', 'budget', 'payment', 'completion', 'hot', 'deadline', 'extra',
              'goAt', 'capacity', 'kinds', 'closed', 'pinLat', 'pinLng', 'updatedAt'];
    }
    // 가는 김에(제가 가요) 일정: 가는 시각·받을 건수(1~5)·부탁 종류·접수 마감·지도 핀.
    // 핀은 '가는 곳'(가게·역)이라 공개해도 되는 위치다. 동네 부탁의 정확한 위치는 여전히 private/detail에만 둔다.
    function goingFieldsValid(m) {
      return (!('goAt' in m) || m.goAt == null || m.goAt is timestamp)
          && (!('capacity' in m) || (m.capacity is int && m.capacity >= 1 && m.capacity <= 5))
          && (!('kinds' in m) || (m.kinds is list && m.kinds.size() <= 4))
          && (!('closed' in m) || m.closed is bool)
          && (!('pinLat' in m) || m.pinLat == null || (m.pinLat is number && m.mode == 'going'))
          && (!('pinLng' in m) || m.pinLng == null || (m.pinLng is number && m.mode == 'going'));
    }
    function requestFieldsValid(m) {
      return str(m.title, 1, 80)
          && str(m.desc, 0, 2000)
          && money(m.price)
          && optMoney(m, 'budget')
          && m.mode in ['ask', 'sea', 'together', 'going']
          && (!('extra' in m) || m.extra == null || m.extra in ['used', 'trip'])
          && optStr(m, 'cat', 30)
          && optStr(m, 'area', 40)
          && optStr(m, 'cell', 12)
          && (!('deadline' in m) || m.deadline == null || m.deadline is timestamp)
          && goingFieldsValid(m);
    }

    match /requests/{requestId} {
      allow read: if true; // 첫 화면 체험용. 비용·남용은 App Check와 조회 단위로 관리(W9)

      allow create: if signedIn()
                    && incoming().ownerUid == request.auth.uid
                    && incoming().status == 'open'
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time
                    && onlyKeys(requestEditable().concat(['ownerUid', 'mode', 'status', 'createdAt']))
                    && requestFieldsValid(incoming());

      // 모집 중일 때 글쓴이가 내용만 고칠 수 있다. 상태·주인·지원자 수는 서버만 바꾼다
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && resource.data.status == 'open'
                    && changedOnly(requestEditable())
                    && incoming().updatedAt == request.time
                    && requestFieldsValid(incoming());

      allow delete: if false; // 모집 취소는 cancelRequest 함수로

      function parent() { return get(/databases/$(database)/documents/requests/$(requestId)).data; }

      // 정확한 위치: 글쓴이와 수락된 수행자만
      match /private/{docId} {
        allow read: if signedIn()
                    && (parent().ownerUid == request.auth.uid || parent().get('helperUid', null) == request.auth.uid);
        allow write: if signedIn()
                     && docId == 'detail'
                     && parent().ownerUid == request.auth.uid
                     && parent().status == 'open'
                     && onlyKeys(['place', 'deliveryPlace', 'lat', 'lng', 'note'])
                     && optStr(incoming(), 'place', 120)
                     && optStr(incoming(), 'deliveryPlace', 120)
                     && optStr(incoming(), 'note', 500)
                     && (!('lat' in incoming()) || incoming().lat is number)
                     && (!('lng' in incoming()) || incoming().lng is number);
      }

      // 공개 댓글: 누구나 읽고, 쓰기는 서버 함수 addComment만(연락처 가리기·알림)
      match /comments/{commentId} {
        allow read: if true;
      }

      // 지원서(신청서): 신청자 본인과 글쓴이만 읽는다. 쓰기는 서버만
      match /applications/{helperUid} {
        allow read: if isMe(helperUid) || (signedIn() && parent().ownerUid == request.auth.uid);
      }
    }

    // '내가 지원한 부탁'(지원자)·'받은 지원'(요청자) 목록 — collectionGroup 조회용
    match /{path=**}/applications/{helperUid} {
      allow read: if signedIn()
                  && (resource.data.helperUid == request.auth.uid || resource.data.requesterUid == request.auth.uid);
    }

    // ── 거래 ──────────────────────────────────────────────────────────────
    match /trades/{tradeId} {
      allow read: if signedIn()
                  && (resource.data.requesterUid == request.auth.uid || resource.data.helperUid == request.auth.uid);

      // 완료 사진 · 영수증 목록(A37). 당사자만 읽고, 쓰기는 서버 함수 addTradePhoto만
      match /photos/{photoId} {
        allow read: if signedIn()
                    && request.auth.uid in [get(/databases/$(database)/documents/trades/$(tradeId)).data.requesterUid,
                                            get(/databases/$(database)/documents/trades/$(tradeId)).data.helperUid];
      }

      // 최소 채팅(결정 5): 거래 당사자만 읽는다. 쓰기는 서버 함수 sendMessage만(연락처 가리기를 거친다)
      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in [get(/databases/$(database)/documents/trades/$(tradeId)).data.requesterUid,
                                            get(/databases/$(database)/documents/trades/$(tradeId)).data.helperUid];
      }
    }

    // ── 제안하기(A15) ─────────────────────────────────────────────────────
    // 누구나 보고, 쓰기는 서버 함수(createProposal · joinProposal · leaveProposal · decideProposal)만
    match /proposals/{proposalId} {
      allow read: if true;
      allow write: if false;
      // 신청: 본인과 제안자만 읽는다
      match /joins/{uid} {
        allow read: if signedIn()
                    && (request.auth.uid == uid
                        || get(/databases/$(database)/documents/proposals/$(proposalId)).data.ownerUid == request.auth.uid);
        allow write: if false;
      }
    }
    // 내가 신청한 제안 목록(collectionGroup)
    match /{path=**}/joins/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ── 신고 ──────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if signedIn()
                    && incoming().reporterUid == request.auth.uid
                    && incoming().createdAt == request.time
                    && onlyKeys(['reporterUid', 'targetUid', 'requestId', 'tradeId', 'reason', 'detail', 'createdAt'])
                    && str(incoming().reason, 1, 50)
                    && optStr(incoming(), 'detail', 1000);
      allow read: if isAdmin();
    }
  }
}
